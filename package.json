{
  "name": "paidinyellow-app",
  "private": true,
  "version": "0.1.0",
  "description": "PaidInYellow Paycheck Payoff Planner (offline PWA).",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:reference": "python engine/engine_reference.py engine/fixtures.json",
    "fixtures:parity": "python engine/make_parity_fixtures.py",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "e2e": "playwright test",
    "build:single": "tsc --noEmit && vite build --config vite.single.config.ts",
    "icons": "node tools/make-icons.mjs",
    "make-keypair": "node scripts/make-keypair.js",
    "make-code": "node scripts/make-code.js",
    "dev:free": "vite --mode free",
    "build:free": "tsc --noEmit && vite build --mode free --outDir dist-free",
    "check-code": "node scripts/check-code.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^0.21.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^2.4.0",
    "@preact/signals": "^1.3.4",
    "idb": "^8.0.4",
    "preact": "^10.29.8"
  }
}
