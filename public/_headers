# Sent by the host with every page. Only this app's own scripts may run, and nothing can be framed in.
# That keeps any toolbar, badge or script the hosting service would add (a Netlify HUD, for one) out of production.
/*
  Content-Security-Policy: script-src 'self' 'unsafe-inline'; frame-src 'none'; object-src 'none'; base-uri 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# The service worker and the page that starts the app are asked for again every time, so a new version is seen at once.
# The files with a hash in their name never change, so those can be kept.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
